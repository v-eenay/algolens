{
  "id": "queue",
  "name": "Queue (FIFO)",
  "category": "Data Structure",
  "description": "A Queue is a linear data structure that follows the First-In-First-Out (FIFO) principle. Elements are added at the rear (enqueue) and removed from the front (dequeue). Like a line of people waiting, the first person to join is the first to be served. Queues are used in scheduling, buffering, and breadth-first search algorithms.",
  "timeComplexity": {
    "best": "O(1)",
    "average": "O(1)",
    "worst": "O(1)"
  },
  "spaceComplexity": "O(n)",
  "code": {
    "python": "class Queue:\n    def __init__(self):\n        self.items = []\n    \n    def enqueue(self, item):\n        \"\"\"Add an item to the rear of the queue\"\"\"\n        self.items.append(item)\n    \n    def dequeue(self):\n        \"\"\"Remove and return the front item\"\"\"\n        if not self.is_empty():\n            return self.items.pop(0)\n        return None\n    \n    def front(self):\n        \"\"\"Return the front item without removing it\"\"\"\n        if not self.is_empty():\n            return self.items[0]\n        return None\n    \n    def is_empty(self):\n        \"\"\"Check if queue is empty\"\"\"\n        return len(self.items) == 0\n    \n    def size(self):\n        \"\"\"Return the number of items in the queue\"\"\"\n        return len(self.items)\n    \n    def display(self):\n        \"\"\"Display all items in the queue\"\"\"\n        return self.items\n\n# Example usage\nqueue = Queue()\nqueue.enqueue(10)\nqueue.enqueue(20)\nqueue.enqueue(30)\nprint(queue.display())  # [10, 20, 30]\nprint(queue.front())    # 10\nprint(queue.dequeue())  # 10\nprint(queue.display())  # [20, 30]",
    "cpp": "#include <iostream>\n#include <queue>\nusing namespace std;\n\nclass Queue {\nprivate:\n    queue<int> items;\n    \npublic:\n    void enqueue(int item) {\n        items.push(item);\n    }\n    \n    int dequeue() {\n        if (!isEmpty()) {\n            int front = items.front();\n            items.pop();\n            return front;\n        }\n        return -1;\n    }\n    \n    int front() {\n        if (!isEmpty()) {\n            return items.front();\n        }\n        return -1;\n    }\n    \n    bool isEmpty() {\n        return items.empty();\n    }\n    \n    int size() {\n        return items.size();\n    }\n    \n    void display() {\n        queue<int> temp = items;\n        while (!temp.empty()) {\n            cout << temp.front() << \" \";\n            temp.pop();\n        }\n        cout << endl;\n    }\n};\n\nint main() {\n    Queue queue;\n    queue.enqueue(10);\n    queue.enqueue(20);\n    queue.enqueue(30);\n    queue.display();  // 10 20 30\n    cout << queue.front() << endl;  // 10\n    cout << queue.dequeue() << endl;  // 10\n    queue.display();  // 20 30\n    return 0;\n}",
    "javascript": "class Queue {\n    constructor() {\n        this.items = [];\n    }\n    \n    enqueue(item) {\n        // Add an item to the rear of the queue\n        this.items.push(item);\n    }\n    \n    dequeue() {\n        // Remove and return the front item\n        if (!this.isEmpty()) {\n            return this.items.shift();\n        }\n        return null;\n    }\n    \n    front() {\n        // Return the front item without removing it\n        if (!this.isEmpty()) {\n            return this.items[0];\n        }\n        return null;\n    }\n    \n    isEmpty() {\n        // Check if queue is empty\n        return this.items.length === 0;\n    }\n    \n    size() {\n        // Return the number of items in the queue\n        return this.items.length;\n    }\n    \n    display() {\n        // Display all items in the queue\n        return this.items;\n    }\n}\n\n// Example usage\nconst queue = new Queue();\nqueue.enqueue(10);\nqueue.enqueue(20);\nqueue.enqueue(30);\nconsole.log(queue.display());  // [10, 20, 30]\nconsole.log(queue.front());    // 10\nconsole.log(queue.dequeue());  // 10\nconsole.log(queue.display());  // [20, 30]"
