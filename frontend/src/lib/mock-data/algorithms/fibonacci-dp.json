{
  "id": "fibonacci-dp",
  "name": "Fibonacci (Dynamic Programming)",
  "category": "Dynamic Programming",
  "description": "Dynamic Programming optimizes recursive algorithms by storing previously computed results (memoization). The Fibonacci sequence is a classic example where DP reduces time complexity from exponential O(2^n) to linear O(n). This approach demonstrates how DP eliminates redundant calculations by building solutions bottom-up or storing results top-down.",
  "timeComplexity": {
    "best": "O(n)",
    "average": "O(n)",
    "worst": "O(n)"
  },
  "spaceComplexity": "O(n)",
  "code": {
    "python": "def fibonacci_dp(n):\n    \"\"\"Calculate nth Fibonacci number using Dynamic Programming\"\"\"\n    if n <= 1:\n        return n\n    \n    # Create memoization table\n    dp = [0] * (n + 1)\n    dp[0] = 0\n    dp[1] = 1\n    \n    # Build solution bottom-up\n    for i in range(2, n + 1):\n        dp[i] = dp[i-1] + dp[i-2]\n    \n    return dp[n]\n\ndef fibonacci_memo(n, memo={}):\n    \"\"\"Calculate using memoization (top-down)\"\"\"\n    if n in memo:\n        return memo[n]\n    if n <= 1:\n        return n\n    \n    memo[n] = fibonacci_memo(n-1, memo) + fibonacci_memo(n-2, memo)\n    return memo[n]\n\n# Example usage\nn = 10\nprint(f\"Fibonacci({n}) = {fibonacci_dp(n)}\")\nprint(f\"Sequence: {[fibonacci_dp(i) for i in range(n+1)]}\")",
    "cpp": "#include <iostream>\n#include <vector>\nusing namespace std;\n\nint fibonacciDP(int n) {\n    if (n <= 1) return n;\n    \n    vector<int> dp(n + 1);\n    dp[0] = 0;\n    dp[1] = 1;\n    \n    for (int i = 2; i <= n; i++) {\n        dp[i] = dp[i-1] + dp[i-2];\n    }\n    \n    return dp[n];\n}\n\nint fibonacciMemo(int n, vector<int>& memo) {\n    if (n <= 1) return n;\n    if (memo[n] != -1) return memo[n];\n    \n    memo[n] = fibonacciMemo(n-1, memo) + fibonacciMemo(n-2, memo);\n    return memo[n];\n}\n\nint main() {\n    int n = 10;\n    \n    cout << \"Fibonacci(\" << n << \") = \" << fibonacciDP(n) << endl;\n    \n    cout << \"Sequence: \";\n    for (int i = 0; i <= n; i++) {\n        cout << fibonacciDP(i) << \" \";\n    }\n    cout << endl;\n    \n    return 0;\n}",
    "javascript": "function fibonacciDP(n) {\n    // Calculate nth Fibonacci number using Dynamic Programming\n    if (n <= 1) return n;\n    \n    // Create memoization table\n    const dp = new Array(n + 1);\n    dp[0] = 0;\n    dp[1] = 1;\n    \n    // Build solution bottom-up\n    for (let i = 2; i <= n; i++) {\n        dp[i] = dp[i-1] + dp[i-2];\n    }\n    \n    return dp[n];\n}\n\nfunction fibonacciMemo(n, memo = {}) {\n    // Calculate using memoization (top-down)\n    if (n in memo) return memo[n];\n    if (n <= 1) return n;\n    \n    memo[n] = fibonacciMemo(n-1, memo) + fibonacciMemo(n-2, memo);\n    return memo[n];\n}\n\n// Example usage\nconst n = 10;\nconsole.log(`Fibonacci(${n}) = ${fibonacciDP(n)}`);\nconsole.log('Sequence:', Array.from({length: n+1}, (_, i) => fibonacciDP(i)));"
  },
